{
  "manifest_version": 3,
  "name": "Save to Research Library",
  "version": "1.1.0",
  "description": "One click finds an article’s PDF, captures citation metadata, and saves to Research Library on this Mac.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save PDF to Research Library",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "status.html",
    "open_in_tab": true
  }
}
